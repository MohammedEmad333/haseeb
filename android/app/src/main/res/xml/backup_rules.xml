<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Haseeb data contains accounting records and credentials for the local
      encrypted database. Never let Android copy raw app files. Users can move
      data only through the app's passphrase-encrypted .hsb backup format.
    -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
